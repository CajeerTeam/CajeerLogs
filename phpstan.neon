parameters:
    level: 0
    paths:
        - core/Kernel
        - core/Config
        - core/Http
        - core/Api/Controller/HealthController.php
        - core/Api/Controller/IdentityController.php
        - core/Api/Controller/IngestController.php
        - core/Api/Controller/LogsController.php
        - core/Search/PostgresFullTextSearchEngine.php
        - core/Log
        - core/Security/SignedPayload.php
        - core/Security/Identity.php
        - core/Security/RateLimiter.php
        - core/Security/Rbac.php
        - core/Security/CsrfProtection.php
        - core/Audit/AuditLogger.php
        - core/Observability/Diagnostics.php
        - core/Observability/HealthCheck.php
        - core/Observability/SystemReport.php
        - core/Observability/PrometheusExporter.php
        - core/Console/Command
        - core/Database
        - core/Installer
        - core/Queue
        - core/Lifecycle
        - core/Scheduler
    bootstrapFiles:
        - core/helpers.php
    tmpDir: storage/cache/phpstan
