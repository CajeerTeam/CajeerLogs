{
  "name": "cajeer/cajeerlogs",
  "description": "Русскоязычный PHP-first сервис для централизованного приема, хранения, поиска и аналитики логов.",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-pdo": "*",
    "psr/log": "^3.0",
    "symfony/console": "^7.0",
    "symfony/http-foundation": "^7.0",
    "symfony/routing": "^7.0",
    "symfony/yaml": "^7.0",
    "ext-ctype": "*",
    "ext-filter": "*",
    "ext-pcre": "*",
    "ext-pdo_pgsql": "*",
    "ext-sodium": "*"
  },
  "suggest": {
    "ext-pdo_mysql": "Future support; not implemented in 0.5.10",
    "ext-pdo_sqlite": "Future support; not implemented in 0.5.10",
    "ext-redis": "Reserved for future optional Redis support",
    "ext-curl": "Required for outgoing webhook worker; future ClickHouse and OTLP support",
    "ext-pcntl": "Required for continuous queue worker signal handling"
  },
  "autoload": {
    "psr-4": {
      "Cajeer\\Logs\\": "core/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cajeer\\Logs\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "doctor": "php bin/cajeer doctor",
    "openapi:lint": "php bin/cajeer openapi:lint",
    "test:runtime": "@php tests/runtime.php",
    "test:load": "python3 tests/load_test.py",
    "analyse": "phpstan analyse --no-progress",
    "lint": "@php bin/cajeer openapi:lint",
    "test:database": "@php tests/database.php",
    "test:transaction": "@php tests/transaction.php",
    "test:transaction-database": "@php tests/transaction_database.php",
    "test:migration-engine": "@php tests/migration_engine.php",
    "test:migration-engine-database": "@php tests/migration_engine_database.php",
    "test:database-config": "@php tests/database_config.php",
    "test:identity": "@php tests/identity.php",
    "test:identity-database": "@php tests/identity_database.php",
    "test:delivery": "@php tests/delivery.php",
    "test:delivery-database": "@php tests/delivery_database.php",
    "test:redaction": "@php tests/redaction.php",
    "test:redaction-database": "@php tests/redaction_database.php",
    "test:hmac": "@php tests/hmac.php",
    "test:hmac-database": "@php tests/hmac_database.php",
    "test:ingest-authorization": "@php tests/ingest_authorization.php",
    "test:ingest": "@php tests/ingest.php",
    "test:ingest-database": "@php tests/ingest_database.php",
    "test:search": "@php tests/search.php",
    "test:search-runtime": "@php tests/search_runtime.php",
    "test:pagination": "@php tests/pagination.php",
    "test:release-pipeline": "@php tests/release_pipeline.php",
    "test:search-database": "@php tests/search_database.php",
    "test:webhooks": "@php tests/webhooks.php",
    "test:webhook-database": "@php tests/webhook_database.php",
    "test:queue": "@php tests/queue.php",
    "test:queue-database": "@php tests/queue_database.php",
    "test:security": "@php tests/security_operations.php",
    "test:security-database": "@php tests/security_database.php",
    "test:projects": "@php tests/projects.php",
    "test:projects-database": "@php tests/projects_database.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1",
    "monolog/monolog": "^3.0"
  }
}
