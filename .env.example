APP_NAME=CajeerLogs
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=ru
APP_TIMEZONE=Europe/Moscow

SERVER_PRIMARY=nginx
SERVER_OPTIONAL=apache

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cajeer_logs
DB_USERNAME=cajeer_logs
DB_PASSWORD=change_me
DB_SCHEMA=public

# optional: mysql, mariadb, sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
SQLITE_DATABASE=storage/database/cajeerlogs.sqlite

CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0

QUEUE_DRIVER=redis
RABBITMQ_DSN=amqp://guest:guest@127.0.0.1:5672/%2f

ANALYTICS_DRIVER=postgres
CLICKHOUSE_DSN=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=cajeer_logs
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

SEARCH_DRIVER=pgsql
MEILISEARCH_HOST=http://127.0.0.1:7700
OPENSEARCH_HOST=http://127.0.0.1:9200

STORAGE_DISK=local
STORAGE_LOCAL_PATH=storage/app
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central1
S3_PATH_STYLE=true

API_PREFIX=/api/v1
API_RATE_LIMIT_PER_MINUTE=600
OPENAPI_PATH=api/openapi.yaml

SECURITY_SESSION_COOKIE=cajeerlogs_session
SECURITY_CSRF_COOKIE=cajeerlogs_csrf
SECURITY_HMAC_SECRET=change_me_64_hex
SECURITY_TOKEN_PEPPER=change_me_64_hex
SECURITY_PRIVACY_HASH_PEPPER=change_me_64_hex
SECURITY_FORCE_HTTPS=false
SECURITY_2FA_REQUIRED_FOR_ADMINS=true

WEBHOOK_SIGNING_SECRET=change_me_webhooks
EVENT_API_ENABLED=true

PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

UPDATE_CHANNEL=stable
UPDATE_REGISTRY_URL=https://gitflic.ru/project/cajeer/cajeerlogs-registry
UPDATE_RELEASES_URL=https://gitflic.ru/project/cajeer/cajeerlogs/release

DOCS_URL=https://gitflic.ru/project/cajeer/cajeerlogs/wiki
