APP_NAME=CajeerLogs
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=ru
APP_TIMEZONE=Europe/Moscow
APP_MAX_BODY_BYTES=1048576

SERVER_PRIMARY=nginx
SERVER_OPTIONAL=apache

# PostgreSQL 17+ (required for installation and database readiness).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cajeer_logs
DB_USERNAME=cajeer_logs
DB_PASSWORD=change_me
DB_SCHEMA=public
DB_SSLMODE=prefer
DB_SSLROOTCERT=
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_APPLICATION_NAME=cajeerlogs
DB_CONNECT_ATTEMPTS=2
DB_CONNECT_RETRY_MS=250
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
DB_KEEPALIVES_IDLE=30
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=3
DB_TCP_USER_TIMEOUT_MS=30000
# DB_MIGRATION_USERNAME and DB_MIGRATION_PASSWORD: inject only into trusted CLI, not here.

# Reserved for future releases: alternate DBs, cache, queue and integrations.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
SQLITE_DATABASE=storage/database/cajeerlogs.sqlite

CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0

QUEUE_DRIVER=pgsql
RABBITMQ_DSN=amqp://guest:guest@127.0.0.1:5672/%2f

ANALYTICS_DRIVER=postgres
CLICKHOUSE_DSN=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=cajeer_logs
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

SEARCH_DRIVER=pgsql
MEILISEARCH_HOST=http://127.0.0.1:7700
OPENSEARCH_HOST=http://127.0.0.1:9200

STORAGE_DISK=local
STORAGE_LOCAL_PATH=storage/app
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central1
S3_PATH_STYLE=true

API_PREFIX=/api/v1
API_RATE_LIMIT_PER_MINUTE=600
SEARCH_TIMEOUT_MS=5000
OPENAPI_PATH=api/openapi.yaml
# Require request HMAC in addition to Bearer tokens (optional by default).
INGEST_REQUIRE_HMAC=false
# Local concurrency slots (0 disables); cooperative processing budget in milliseconds.
INGEST_MAX_INFLIGHT=16
INGEST_BUDGET_MS=25000
# Zero disables each timestamp admission window.
INGEST_IDEMPOTENCY_SECONDS=604800
INGEST_MAX_EVENT_AGE_SECONDS=0
INGEST_MAX_EVENT_FUTURE_SECONDS=0

# Identity cookie is fixed: cajeerlogs_session; CSRF is returned in JSON and sent as X-CSRF-Token.
SECURITY_HMAC_SECRET=change_me_64_hex
SECURITY_TOKEN_PEPPER=change_me_64_hex
SECURITY_PRIVACY_HASH_PEPPER=change_me_64_hex
SECURITY_FORCE_HTTPS=false
SECURITY_2FA_REQUIRED_FOR_ADMINS=true

# Legacy settings retained for installer compatibility; 0.0.7 uses per-hook CAJEER_WEBHOOK_* secrets.
WEBHOOK_SIGNING_SECRET=change_me_webhooks
EVENT_API_ENABLED=true
# Example (generate a unique secret and set it only in protected .env or worker environment):
# CAJEER_WEBHOOK_MY_APP=

PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

UPDATE_CHANNEL=stable
UPDATE_REGISTRY_URL=https://gitflic.ru/project/cajeer/cajeerlogs-registry
UPDATE_RELEASES_URL=https://gitflic.ru/project/cajeer/cajeerlogs/release

DOCS_URL=https://gitflic.ru/project/cajeer/cajeerlogs/wiki

# Max pending/running/dead asynchronous jobs per database schema.
QUEUE_MAX_JOBS=1000

# Optional dedicated 64-hex TOTP encryption key. If unset, the installer-generated
# SECURITY_HMAC_SECRET is domain-separated and used instead. Never change the
# effective key after enrollment or signing-key provisioning; preserve it in a separate encrypted backup.
SECURITY_TOTP_KEY=
# Metrics are public unless this token is configured; restrict access at the proxy.
PROMETHEUS_TOKEN=
# Empty = storage/backups/private (0700). Use a separate private filesystem in production.
BACKUP_DIR=
PG_DUMP_BIN=/usr/bin/pg_dump
PG_RESTORE_BIN=/usr/bin/pg_restore

# Trusted installer/recovery process only (do not persist these in .env):
# CAJEER_ADMIN_EMAIL, CAJEER_ADMIN_PASSWORD or CAJEER_ADMIN_PASSWORD_FILE
# CAJEER_ADMIN_NEW_PASSWORD or CAJEER_ADMIN_NEW_PASSWORD_FILE
