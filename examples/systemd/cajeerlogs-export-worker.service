[Unit]
Description=CajeerLogs bulk export worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/cajeerlogs
ExecStart=/usr/bin/php /opt/cajeerlogs/bin/cajeer exports:work 5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/cajeerlogs/storage
