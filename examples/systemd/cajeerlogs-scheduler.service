[Unit]
Description=CajeerLogs bounded maintenance scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cajeerlogs
Group=cajeerlogs
WorkingDirectory=/var/www/cajeerlogs
ExecStart=/usr/bin/php bin/cajeer scheduler:run
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
