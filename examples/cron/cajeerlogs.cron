# Install into the application OS user's crontab; use actual project and PHP paths.
# Use cron OR systemd timers, not both. Scheduler serializes and persists task runs.
* * * * * cd /var/www/cajeerlogs && /usr/bin/php bin/cajeer scheduler:run
# Prefer a continuous systemd worker; finite cron batches are an alternative.
# * * * * * cd /var/www/cajeerlogs && /usr/bin/php bin/cajeer queue:work 100
# Enable separately if outgoing webhooks are configured (ext-curl required).
# * * * * * cd /var/www/cajeerlogs && /usr/bin/php bin/cajeer webhook:work 20
