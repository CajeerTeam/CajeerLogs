#!/usr/bin/env php
<?php
declare(strict_types=1);

use Cajeer\Logs\Console\Command\DoctorCommand;
use Cajeer\Logs\Console\Command\WebhookCommand;
use Cajeer\Logs\Console\Command\AuthCleanupCommand;
use Cajeer\Logs\Console\Command\InstallCheckCommand;
use Cajeer\Logs\Console\Command\SystemReportCommand;
use Cajeer\Logs\Console\Command\OpenApiLintCommand;
use Cajeer\Logs\Console\Command\InstallCommand;
use Cajeer\Logs\Console\Command\MigrateCommand;
use Cajeer\Logs\Console\Command\DbDoctorCommand;
use Cajeer\Logs\Database\DatabaseException;

ini_set('display_errors', '0');
error_reporting(E_ALL);
$command = $argv[1] ?? 'help';
if ($command === 'help' || $command === '--help') {
    echo "CajeerLogs CLI\nUsage: php bin/cajeer <command>\nCommands: storage:archive stage|evict|restore-hot|cold|cold-list|verify-cold|scrub-cold|restore-cold|status, analytics:clickhouse status|migrate|aggregate|record, analytics:replication status|work|drain|backfill|replay|aggregate|compare, analytics:rollups backfill|status|verify|aggregate, version, install [--dry-run], install:check, upgrade:check BACKUP_ID, upgrade BACKUP_ID --confirm-stopped, install:status, install:prepare-schema --confirm, admin:reset-password EMAIL --confirm [--unblock], migrate, migrate:status, migrate:plan, migrate:verify, migrate:certify, db:doctor, doctor, health:ready, health:worker ROLE, system:report, openapi:lint, auth:cleanup, import:aapanel [--config PRIVATE_JSON init|discover|set|run|status|list], webhook:add, webhook:list, webhook:history, webhook:disable, webhook:retry, webhook:work, webhook:cleanup, exports:work [limit], exports:cleanup\nQueue: queue:dispatch, queue:pause [REASON] --confirm, queue:resume --confirm, queue:drain [SECONDS] --confirm, queue:work [limit], queue:pool [processes], queue:workers, queue:pool-health [expected], queue:status, queue:recover [LIMIT] --confirm, queue:capacity, queue:verify, queue:reconcile --confirm, queue:list STATUS, queue:history ID, queue:retry ID, queue:discard ID, scheduler:run, retention:list, retention:set PROJECT DAYS|off, retention:run [limit], retention:preview [limit [PROJECT]], retention:history, retention:cycle --confirm\nLogs: logs:export-jsonl PROJECT [SOURCE_UUID], logs:import-jsonl --file FILE --state STATE --source SLUG [--signed], logs:legacy-count, logs:legacy-list [LIMIT [AFTER_UUID]], logs:legacy-adopt EVENT PROJECT SOURCE_UUID --confirm, logs:redact-history PROJECT --dry-run|--apply --confirm [LIMIT [AFTER_UUID]]\nDatabase: db:verify [limit], db:integrity [limit], db:performance, db:explain PROJECT [--trace TRACE] [--filters JSON] [--analyze]\nOperations: security:audit [--tls], operations:check [BACKUP_ID], operations:triage [BACKUP_ID], operations:incident [BACKUP_ID], tls:check [CA_FILE [WARNING_DAYS]], audit:verify [POSITION HASH], backup:create, backup:run, backup:history, backup:replicate ID, backup:offsite-list, backup:offsite-verify ID, backup:fetch ID, backup:rehearse ID EMPTY_DB, backup:dr-certify ID EMPTY_DB MAX_RPO_SECONDS MAX_RTO_SECONDS, backup:prune [--confirm], backup:list, backup:verify ID, backup:restore ID EMPTY_DB, update:check FILE, auth:2fa-reset EMAIL --confirm, auth:totp-key-rotate --confirm [LIMIT], auth:totp-key-verify\n";
    exit(0);
}
$pending = ['alert:dispatch' => '0.3.x'];
if (isset($pending[$command])) {
    fwrite(STDERR, "$command is not implemented in this release (planned for {$pending[$command]}).\n");
    exit(69);
}
if ($command === 'import:aapanel' || $command === 'logs:import-jsonl') {
    $rawArgs=array_slice($argv,2);
    if ($command==='logs:import-jsonl') {
        // A completed archive must not be treated as a tailing log or a different format.
        foreach ($rawArgs as $arg) { if ($arg==='--format' || str_starts_with($arg,'--format=')) { fwrite(STDERR,"Archive import uses cajeer-jsonl format.\n"); exit(64); } }
        $rawArgs=[...$rawArgs,'--format','cajeer-jsonl','--once'];
    }
    $args = array_map('escapeshellarg', $rawArgs);
    $manager = $command === 'import:aapanel' && (in_array('--config', $rawArgs, true) || count(array_filter($rawArgs, static fn($arg) => str_starts_with($arg, '--config='))) > 0);
    $script = $manager ? 'cajeer_aapanel_manager.py' : 'cajeer_logs_collector.py';
    passthru('python3 ' . escapeshellarg(dirname(__DIR__) . '/clients/python/' . $script) . ' ' . implode(' ', $args), $code);
    exit($code);
}
if (!in_array($command, ['storage:archive','analytics:clickhouse','analytics:replication','analytics:rollups','version','--version','install:check','upgrade:check','upgrade','install:status','install:prepare-schema','admin:reset-password','doctor','health:ready','health:worker','system:report','openapi:lint','install','migrate','migrate:status','migrate:plan','migrate:verify','migrate:certify','db:doctor','db:verify','db:integrity','db:performance','db:explain','auth:cleanup','webhook:add','webhook:list','webhook:history','webhook:disable','webhook:retry','webhook:work','webhook:cleanup','queue:work','queue:pool','queue:workers','queue:pool-health','queue:status','queue:recover','queue:capacity','queue:verify','queue:reconcile','queue:projects','queue:project','queue:project-set','queue:project-verify','queue:project-reconcile','queue:dispatch','queue:pause','queue:resume','queue:drain','queue:list','queue:history','queue:retry','queue:discard','scheduler:run','retention:list','retention:set','retention:run','retention:preview','retention:history','retention:cycle','security:audit','operations:check','operations:triage','operations:incident','tls:check','audit:verify','backup:create','backup:run','backup:history','backup:replicate','backup:offsite-list','backup:offsite-verify','backup:fetch','backup:rehearse','backup:dr-certify','backup:prune','backup:list','backup:verify','backup:restore','update:check','auth:2fa-reset','auth:totp-key-rotate','auth:totp-key-verify','exports:work','exports:cleanup','logs:export-jsonl','logs:legacy-count','logs:legacy-list','logs:legacy-adopt','logs:redact-history'], true)) {
    fwrite(STDERR, "Unknown command. Run php bin/cajeer help.\n");
    exit(64);
}
set_error_handler(static function (int $severity, string $message, string $file, int $line): bool {
    if (!(error_reporting() & $severity)) { return false; }
    throw new ErrorException($message, 0, $severity, $file, $line);
});
try {
    $app = require dirname(__DIR__) . '/core/bootstrap.php';
    if (in_array($command, ['version','--version'], true)) {
        echo $app->version() . PHP_EOL;
        exit(0);
    }
    $app->boot();
    if ($command==='health:ready' || $command==='health:worker') {
        $args=array_slice($argv,2);
        if ($command==='health:ready' && $args===[]) $result=(new \Cajeer\Logs\Observability\Readiness($app))->check();
        elseif ($command==='health:worker' && count($args)===1 && isset(\Cajeer\Logs\Observability\WorkerHeartbeat::ROLES[$args[0]])) $result=(new \Cajeer\Logs\Observability\WorkerHeartbeat($app->basePath('storage/cache')))->snapshot()[$args[0]];
        else { fwrite(STDERR,"Usage: health:ready | health:worker queue|scheduler|webhook|backup\n"); exit(64); }
        echo json_encode($result,JSON_THROW_ON_ERROR).PHP_EOL;
        exit($result['status']==='ok'?0:1);
    }
    if ($command==='storage:archive') { exit((new \Cajeer\Logs\Console\Command\StorageArchiveCommand($app))->handle(array_slice($argv,2))); }
    if ($command==='analytics:rollups') { exit((new \Cajeer\Logs\Console\Command\AnalyticsRollupCommand($app))->handle(array_slice($argv,2))); }
    if ($command==='analytics:replication') { exit((new \Cajeer\Logs\Console\Command\AnalyticsReplicationCommand($app))->handle(array_slice($argv,2))); }
    if ($command==='analytics:clickhouse') { exit((new \Cajeer\Logs\Console\Command\ClickHouseCommand($app))->handle(array_slice($argv,2))); }
    if ($command==='operations:triage' || $command==='operations:incident') {
        if (count($argv)>3) throw new DatabaseException('Usage: operations:triage|operations:incident [BACKUP_ID]');
        $report=(new \Cajeer\Logs\Operations\IncidentTriage($app))->collect($argv[2]??null);
        if ($command==='operations:incident') {
            $path=\Cajeer\Logs\Operations\IncidentSnapshot::save($app->basePath('storage'),$report);
            echo json_encode(['status'=>$report['status'],'report'=>$path,'version'=>$report['version']],JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES).PHP_EOL;
        } else {
            echo json_encode($report,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES).PHP_EOL;
        }
        exit(\Cajeer\Logs\Operations\IncidentTriage::exitCode($report));
    }
    if ($command==='security:audit') {
        $args=array_slice($argv,2);
        if ($args!==[] && $args!==['--tls']) throw new DatabaseException('Usage: security:audit [--tls]');
        try { $pdo=(new \Cajeer\Logs\Observability\Readiness($app))->factory()->make('pgsql'); }
        catch (\Throwable) { $pdo=null; }
        $report=\Cajeer\Logs\Security\SecurityPosture::evaluate($app->config(),$pdo,$args===['--tls'],true);
        echo json_encode($report,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES).PHP_EOL;
        exit($report['status']==='ok'?0:2);
    }
    if ($command==='operations:check') {
        if (count($argv)>3) throw new DatabaseException('Usage: operations:check [BACKUP_ID]');
        $report=(new \Cajeer\Logs\Operations\OperationsCheck($app))->run($argv[2]??null);
        echo json_encode($report,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT).PHP_EOL; exit($report['status']==='ok'?0:1);
    }
    if ($command==='tls:check') {
        $args=array_slice($argv,2);
        $days=filter_var($args[1]??14,FILTER_VALIDATE_INT,['options'=>['min_range'=>0,'max_range'=>365]]);
        if (count($args)>2 || $days===false) throw new DatabaseException('Usage: tls:check [CA_FILE [WARNING_DAYS]]');
        $report=\Cajeer\Logs\Security\TlsProbe::check($app->config()->get('app.url'),$args[0]??null,$days);
        echo json_encode($report,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES).PHP_EOL;
        exit($report['status']==='ok'?0:1);
    }
    if (in_array($command,['auth:totp-key-rotate','auth:totp-key-verify'],true)) {
        $args=array_slice($argv,2);
        if ($command==='auth:totp-key-rotate' && (array_shift($args)!=='--confirm' || count($args)>1)) throw new DatabaseException('Usage: auth:totp-key-rotate --confirm [LIMIT]');
        if ($command==='auth:totp-key-verify' && $args!==[]) throw new DatabaseException('Usage: auth:totp-key-verify');
        $limit=filter_var($args[0]??100,FILTER_VALIDATE_INT,['options'=>['min_range'=>1,'max_range'=>500]]);
        if ($limit===false) throw new DatabaseException('Invalid rotation batch size.');
        $pdo=$app->container()->get(PDO::class);
        $guard=$app->container()->get(\Cajeer\Logs\Database\MigrationRunner::class)->guard();
        try { $manager=\Cajeer\Logs\Security\TwoFactorManager::fromConfig($pdo,$app->config()); $result=$command==='auth:totp-key-rotate'?$manager->rotateBatch($limit):$manager->verifyKeys(); }
        finally { $guard->release(); }
        echo json_encode($result,JSON_THROW_ON_ERROR).PHP_EOL; exit(0);
    }
    if (in_array($command,['db:verify','db:integrity','db:performance','db:explain'],true)) { exit((new \Cajeer\Logs\Console\Command\DatabaseMaintenanceCommand($app))->handle($command,array_slice($argv,2))); }
    if ($command==='logs:redact-history') {
        $args=array_slice($argv,2); $project=array_shift($args); $mode=array_shift($args);
        if ($project===null || !in_array($mode,['--dry-run','--apply'],true) || ($mode==='--apply' && array_shift($args)!=='--confirm') || count($args)>2) throw new DatabaseException('Usage: logs:redact-history PROJECT --dry-run|--apply --confirm [LIMIT [AFTER_UUID]]');
        $limit=filter_var($args[0]??25,FILTER_VALIDATE_INT,['options'=>['min_range'=>1,'max_range'=>50]]);
        if ($limit===false) throw new DatabaseException('Invalid history batch limit.');
        $guard=$app->container()->get(\Cajeer\Logs\Database\MigrationRunner::class)->guard();
        $pdo=$app->container()->get(PDO::class);
        try { $result=(new \Cajeer\Logs\Database\TransactionManager($pdo))->run(fn()=>(new \Cajeer\Logs\Log\LogRepository($pdo))->redactHistory($project,$args[1]??null,$limit,$mode==='--apply')); }
        finally { $guard->release(); }
        echo json_encode($result,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT).PHP_EOL; exit(0);
    }
    if (str_starts_with($command,'exports:')) { exit((new \Cajeer\Logs\Console\Command\ExportCommand($app))->handle($command,array_slice($argv,2))); }
    if (str_starts_with($command,'logs:')) { exit((new \Cajeer\Logs\Console\Command\LogRepositoryCommand($app))->handle($command,array_slice($argv,2))); }
    if (!in_array($command,['queue:work','queue:pool','queue:workers','queue:pool-health'],true) && (str_starts_with($command,'queue:') || str_starts_with($command,'webhook:') || str_starts_with($command,'retention:') || in_array($command,['scheduler:run','auth:cleanup','auth:2fa-reset'],true))) { $schemaGuard=$app->container()->get(\Cajeer\Logs\Database\MigrationRunner::class)->guard(); }
    if ($command==='audit:verify' || str_starts_with($command,'backup:') || $command==='update:check' || $command==='auth:2fa-reset') { exit((new \Cajeer\Logs\Console\Command\OperationsCommand($app))->handle($command,array_slice($argv,2))); }
    if ($command === 'upgrade') {
        if (count($argv)!==4 || $argv[3]!=='--confirm-stopped') throw new DatabaseException('Usage: upgrade BACKUP_ID --confirm-stopped (stop API writers and background workers first)');
        $result=(new \Cajeer\Logs\Installer\UpgradeInstaller($app))->run($argv[2]);
        echo json_encode($result,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES).PHP_EOL;
        exit(0);
    }
    if ($command === 'upgrade:check') {
        if (count($argv)!==3) throw new DatabaseException('Usage: upgrade:check BACKUP_ID');
        echo json_encode((new \Cajeer\Logs\Installer\UpgradePreflight($app))->check($argv[2]),JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT).PHP_EOL;
        exit(0);
    }
    if ($command === 'install:prepare-schema') {
        if (array_slice($argv,2)!==['--confirm']) { throw new DatabaseException('Usage: install:prepare-schema --confirm'); }
        $result=(new \Cajeer\Logs\Installer\SchemaPreparation($app))->run();
        echo json_encode($result,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT).PHP_EOL;
        exit(0);
    }
    if ($command === 'install:status') {
        if (count($argv)!==2) { throw new DatabaseException('Usage: install:status'); }
        $report=(new \Cajeer\Logs\Installer\InstallationStatus($app))->report();
        echo json_encode($report,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT).PHP_EOL;
        exit($report['state']==='ready'?0:1);
    }
    if ($command === 'admin:reset-password') {
        $args=array_slice($argv,2);
        if (!in_array(count($args),[2,3],true) || $args[1]!=='--confirm' || (count($args)===3 && $args[2]!=='--unblock')) { throw new DatabaseException('Usage: admin:reset-password EMAIL --confirm [--unblock]'); }
        $password=\Cajeer\Logs\Installer\AdministratorPassword::supplied('CAJEER_ADMIN_NEW_PASSWORD','CAJEER_ADMIN_NEW_PASSWORD_FILE');
        if ($password==='' && stream_isatty(STDIN) && stream_isatty(STDERR)) {
            $reader=new InstallCommand($app); $password=$reader->secret('New administrator password: ');
            if ($password!==$reader->secret('Repeat password: ')) { throw new DatabaseException('Passwords do not match.'); }
        }
        \Cajeer\Logs\Installer\AdministratorPassword::validate($password);
        $guard=$app->container()->get(\Cajeer\Logs\Database\MigrationRunner::class)->guard();
        try { $result=$app->container()->get(\Cajeer\Logs\Database\Repository\UserRepository::class)->resetAdministratorPassword($args[0],$password,count($args)===3); }
        finally { $guard->release(); }
        echo json_encode($result,JSON_THROW_ON_ERROR|JSON_PRETTY_PRINT).PHP_EOL;
        exit(0);
    }
    if ($command === 'install') { exit((new InstallCommand($app))->handle(array_slice($argv, 2))); }
    if (str_starts_with($command, 'webhook:')) { exit((new WebhookCommand($app))->handle($command,array_slice($argv,2))); }
    if (str_starts_with($command,'queue:')) { exit((new \Cajeer\Logs\Console\Command\QueueWorkCommand($app))->handle($command,array_slice($argv,2))); }
    if ($command==='scheduler:run' || str_starts_with($command,'retention:')) { exit((new \Cajeer\Logs\Console\Command\SchedulerRunCommand($app))->handle($command,array_slice($argv,2))); }
    if (count($argv) > 2) { throw new DatabaseException('Unexpected command arguments.'); }
    if (in_array($command,['migrate','migrate:status','migrate:plan','migrate:verify','migrate:certify'],true)) { exit((new MigrateCommand($app))->handle($command)); }
    $handler = match ($command) {
        'auth:cleanup' => new AuthCleanupCommand($app),
        'install:check' => new InstallCheckCommand($app),
        'db:doctor' => new DbDoctorCommand($app),
        'doctor' => new DoctorCommand($app),
        'system:report' => new SystemReportCommand($app),
        'openapi:lint' => new OpenApiLintCommand($app),
    };
    exit($handler->handle());
} catch (Throwable $error) {
    // Configuration validation messages contain field names, not values. Other errors may contain secrets.
    fwrite(STDERR, 'Runtime failure: ' . ($error instanceof DatabaseException || $error instanceof RuntimeException && preg_match('/^(Invalid |APP_|Metrics path|Duplicate \.env|Cannot read environment|PHP 8\.4)/', $error->getMessage()) ? $error->getMessage() : $error::class) . PHP_EOL);
    exit(1);
}
