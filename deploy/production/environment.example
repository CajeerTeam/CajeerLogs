# Copy to .env.production, chmod 600, replace placeholders with unique secrets.
APP_URL=https://logs.example.com
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
PROMETHEUS_TOKEN=REPLACE_WITH_RANDOM_HEX
CAJEER_TLS_DIR=/etc/cajeerlogs/tls
CAJEER_HTTPS_BIND=0.0.0.0
CAJEER_HTTPS_PORT=443
# Empty by default; only exact last-hop proxy IP/CIDR, never public networks.
SECURITY_TRUSTED_PROXIES=

SEARCH_TIMEOUT_MS=5000
INGEST_MAX_INFLIGHT=16
INGEST_BUDGET_MS=25000
INGEST_MAX_EVENT_AGE_SECONDS=0
INGEST_MAX_EVENT_FUTURE_SECONDS=0

SECURITY_SESSION_TTL_SECONDS=28800

# Identity policy (production Compose defaults to idle 1800 and recent auth 300).
# Explicit 0 disables the corresponding check; recommended production profile keeps both enabled.
SECURITY_2FA_REQUIRED_ROLES=
SECURITY_2FA_REQUIRED_PERMISSIONS=
SECURITY_SESSION_IDLE_SECONDS=1800
SECURITY_REAUTH_SECONDS=300
SECURITY_TOTP_ACTIVE_KEY=
SECURITY_TOTP_PREVIOUS_KEY=

# Shared API budgets (requests per minute, token bucket burst percentage).
API_RATE_LIMIT_PER_MINUTE=600
API_RATE_SEARCH_PER_MINUTE=120
API_RATE_ANALYTICS_PER_MINUTE=30
API_RATE_EXPORT_PER_MINUTE=10
API_RATE_ADMIN_WRITE_PER_MINUTE=60
API_RATE_BURST_PERCENT=100

# Backup operations (offsite is a private independently mounted filesystem).
BACKUP_OFFSITE_DIR=
# 64 hex characters; prefer an operator-owned 0600 BACKUP_ENCRYPTION_KEY_FILE.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_FILE=
BACKUP_TIMEOUT_SECONDS=3600
BACKUP_MIN_FREE_BYTES=104857600
RETENTION_SCHEDULER_ENABLED=true
RETENTION_WINDOW_UTC=
STORAGE_WARN_BYTES=1073741824
RETENTION_BATCH_SIZE=1000
RETENTION_TIMEOUT_MS=5000
RETENTION_CYCLE_BATCHES=10
RETENTION_CYCLE_BUDGET_MS=30000
RETENTION_PAUSE_MS=100
WEBHOOK_RETENTION_DAYS=30
QUEUE_RETENTION_FLOOR_SECONDS=0

BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_LOCAL=0
BACKUP_KEEP_DAILY=0
BACKUP_KEEP_WEEKLY=0
BACKUP_KEEP_MONTHLY=0
BACKUP_OFFSITE_REQUIRE_DISTINCT_DEVICE=true

# Enable backup freshness/worker alerting if scheduled backups are operated.
MONITOR_BACKUP_ENABLED=false

# Queue worker runtime (continuous processes)
QUEUE_MAX_ATTEMPTS=8
QUEUE_RETRY_BASE_SECONDS=5
QUEUE_RETRY_MAX_SECONDS=3600
QUEUE_RETRY_JITTER_PERCENT=25
QUEUE_OUTAGE_BASE_MS=250
QUEUE_OUTAGE_MAX_MS=30000
QUEUE_OUTAGE_MAX_FAILURES=10
QUEUE_WORKER_PROCESSES=2
QUEUE_WORKER_BATCH_JOBS=4
QUEUE_WORKER_MAX_JOBS=1000
QUEUE_WORKER_MAX_SECONDS=3600
QUEUE_WORKER_MEMORY_MB=256
QUEUE_POLL_MIN_MS=50
QUEUE_POLL_MAX_MS=1000
QUEUE_LEASE_SECONDS=120
QUEUE_CLAIM_TIMEOUT_MS=5000
QUEUE_PROCESS_TIMEOUT_SECONDS=90
QUEUE_SHUTDOWN_GRACE_SECONDS=120

# Durable multidimensional queue admission (0=disabled for events/bytes)
QUEUE_MAX_EVENTS=100000
QUEUE_MAX_BYTES=536870912
QUEUE_HIGH_WATERMARK_PERCENT=85
QUEUE_LOW_WATERMARK_PERCENT=60

# Optional AI Assistant: external data transfer, disabled by default.
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
AI_ASSISTANT_INCLUDE_MESSAGES=false
